# SQLite database URL for async SQLAlchemy (aiosqlite driver)
# Development: sqlite+aiosqlite:///./simple-todo.db
# Production: sqlite+aiosqlite:////data/simple-todo.db (Railway persistent volume)
DATABASE_URL=sqlite+aiosqlite:///./simple-todo.db

# Comma-separated list of allowed CORS origins
# Development: http://localhost:5173
# Production: (leave empty — same-origin via Caddy, no CORS needed)
ALLOWED_ORIGINS=http://localhost:5173

# VAPID keys for Web Push notifications
# Generate with: uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); ..."
# Private key: base64url-encoded PKCS8 PEM
VAPID_PRIVATE_KEY=

# Public key: base64url-encoded uncompressed EC point (copy to frontend VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=

# Contact email for VAPID claim (mailto: subject in push requests)
VAPID_CLAIM_EMAIL=your-email@example.com
